{
  "name": "@benjaming61001/use-handle-loading",
  "version": "0.1.1",
  "description": "A lightweight TypeScript utility for managing async loading states with success/error/finally hooks.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt src/",
    "format:fix": "oxfmt src/ --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benjaming61001/use-handle-loading.git"
  },
  "keywords": [
    "loading",
    "async",
    "hooks",
    "typescript",
    "utility"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Benjaming61001/use-handle-loading/issues"
  },
  "homepage": "https://github.com/Benjaming61001/use-handle-loading#readme",
  "devDependencies": {
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}